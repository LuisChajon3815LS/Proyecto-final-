package com.gestionventas;
import java.io.Serializable;
public class Producto implements Serializable {
 private static final long serialVersionUID=1L;
 private final String codigo,nombre,descripcion,marca; private final double precio;
 public Producto(String codigo,String nombre,String descripcion,String marca,double precio){
  this.codigo=codigo;this.nombre=nombre;this.descripcion=descripcion;this.marca=marca;this.precio=precio;
 }
 public String getCodigo(){return codigo;} public String getNombre(){return nombre;}
 public String getDescripcion(){return descripcion;} public String getMarca(){return marca;} public double getPrecio(){return precio;}
 public String toString(){return codigo+" - "+nombre+" (Q"+String.format("%.2f",precio)+")";}
}
